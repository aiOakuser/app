# Secret used to sign session cookies. Required outside local dev —
# without it the app falls back to a fixed, publicly-known dev secret.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Twilio credentials for sending the real OTP SMS (src/lib/sms.ts). Without
# these, OTP codes are only logged to the server console and shown on-screen.
# Get these from https://console.twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A phone number (E.164, e.g. +14155551234) or Messaging Service you own in Twilio.
TWILIO_FROM_NUMBER=
