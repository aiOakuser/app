# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# secrets & credentials: certs, private keys, cloud/service-account creds
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa*
id_ed25519*
*.tfstate
*.tfstate.*
service-account*.json
credentials.json
/secrets/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# stray python venv (this is a Node app; a venv here means someone ran a
# git command from inside a Python-venv'd shell on the EC2 box by mistake)
/venv

# typescript
*.tsbuildinfo
next-env.d.ts
.claude
.vscode
.env
