# Optional settings for deploy/setup-server.sh. Copy to deploy/.env only to
# override a default; every value below already has a working production default.
#
# The app does NOT read this file. The runtime secrets (AUTH_SECRET, TWILIO_*,
# TENANT_SLUG) are seeded into /etc/app.env on the FIRST run, a root-only file
# (mode 600) that the systemd unit loads. After that, edit /etc/app.env and run
# `sudo systemctl restart app`. Re-running the script never overwrites it.

# Git remote to clone on first run (not needed once a checkout exists)
REPO_URL=https://github.com/aiOakuser/app.git

# Branch the server deploys. The script checks it out and fast-forwards it.
BRANCH=master

APP_NAME=app
APP_DIR=/var/www/app
# The app runs, and owns its files, as this user. Never root.
APP_USER=www-data
DOMAIN=app.aioak.io
PORT=8003

# Cloudflare Origin certificate and key for $DOMAIN, created in the Cloudflare
# dashboard (SSL/TLS -> Origin Server -> Create Certificate). Nginx is not
# configured, and Cloudflare returns 525/526, until both files exist.
# CERT=/etc/nginx/ssl/aioak-origin.crt
# KEY=/etc/nginx/ssl/aioak-origin.key

# --- Seed values for /etc/app.env (used only when that file does not exist) ---

# Which business this deployment's root sign-in page (src/app/page.tsx) shows.
# Must match a slug in src/lib/tenants.ts. Each white-label deployment sets
# its own value here; the app code itself stays tenant-agnostic.
TENANT_SLUG=riverstone-dental

# Signs session JWTs (src/lib/session.ts). Leave blank and the script generates
# a strong one. Without any value the app falls back to an insecure dev secret.
AUTH_SECRET=

# Twilio credentials for sending the real OTP SMS (src/lib/sms.ts). Without
# these, OTP codes are only logged to the server console; no SMS goes out.
# Get these from https://console.twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A phone number (E.164, e.g. +14155551234) or Messaging Service you own in Twilio.
TWILIO_FROM_NUMBER=
