# Copy to deploy/.env and fill in real values before running setup-server.sh.
# This file is sourced by setup-server.sh (for the vars below) and is also
# wired into the app's systemd unit via EnvironmentFile, so anything here
# (like AUTH_SECRET) is available to the running Next.js process too.

# Git remote to clone on first run (not needed on subsequent `git pull` runs)
REPO_URL=git@github.com:aiOakuser/app.git

APP_NAME=app
APP_DIR=/var/www/app
DOMAIN=app.globaldesignerhub.com
DEPLOY_USER=ubuntu
CERTBOT_EMAIL=
PORT=8003

# Required in production: signs session JWTs (src/lib/session.ts). Without
# this, the app falls back to an insecure hardcoded dev secret.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
